<view class="container {{uiV2 ? 'ui-v2' : ''}}">
    <view class="ui-error-card" wx:if="{{hasError && uiV2}}">
        <text class="ui-error-text">{{errorMessage}}</text>
        <van-button size="small" type="danger" plain bindtap="retryLoad">重试</van-button>
    </view>
    <view wx:if="{{hasError && !uiV2}}" style="padding:16rpx 24rpx;background:#fff7f7;color:#d93025;font-size:24rpx;">
        <text>{{errorMessage}}</text>
        <button size="mini" bindtap="retryLoad" style="margin-left:16rpx;">重试</button>
    </view>
    <view class="search">
        <navigator url="/pages/search/search" class="input">
            <image lazy-load="true" class="icon" src="/images/icon/search.png"></image>
            <text class="txt">搜索, 共{{goodsCount}}款好味</text>
        </navigator>
    </view>
    <view class="catalog">
        <scroll-view class="nav" scroll-y="true">
            <view class="item {{ nowId == 0 ?'active' : ''}}" bindtap="switchCate" data-id="0">全部</view>
            <view class="item {{ nowId == item.id?'active' : ''}}" wx:for="{{navList}}" wx:key="id" data-id="{{item.id}}" bindtap="switchCate">{{item.name}}</view>
        </scroll-view>
        <scroll-view class="cate" scroll-y="true" lower-threshold="120" bindscrolltolower="onBottom" bindscroll="onCateScroll">
            <block wx:if="{{loading == 0}}">
                <view class='banner-container' wx:if="{{nowId!= 0 && index_banner_img == 1}}">
                    <image lazy-load="true" mode='aspectFill' style="width:100%;height:{{currentCategory.p_height}}rpx" src='{{currentCategory.img_url}}'>
                    </image>
                    <view class="bg" style="height:{{currentCategory.p_height}}rpx;line-height:{{currentCategory.p_height}}rpx;"></view>
                    <view class="text" style="height:{{currentCategory.p_height}}rpx;line-height:{{currentCategory.p_height}}rpx;">{{currentCategory.name}}</view>
                </view>
                <view class='list-wrap clearfix'>
                    <view class="goods-box {{(index+1)%2 == 0?'no-margin':''}}" wx:for="{{list}}" wx:for-index="index" wx:for-item="item" wx:key="id">
                        <navigator hover-class='none' class='navi-url' url="/pages/goods/goods?id={{item.id}}">
                            <view class="box">
                                <image lazy-load="true" src="{{item.list_pic_url}}" class="image"></image>
                                <van-tag wx:if="{{uiV2 && item.is_new == 1}}" class='new-tag' type="danger" plain>新品</van-tag>
                                <view wx:if="{{!uiV2 && item.is_new == 1}}" class='new-tag'>新品</view>
                                <block wx:if="{{item.goods_number <= 0}}">
                                    <!-- <view class='no-goods-mask'></view> -->
                                    <view class='sold-img'>
                                        <image lazy-load="true" class='soldout' src='/images/icon/sold-out.png'></image>
                                    </view>
                                </block>
                            </view>
                            <view class="goods-info {{item.goods_number <= 0?'fast-out-status':''}}">
                                <view class="goods-title">{{item.name}}</view>
                                <view class="goods-intro">{{item.goods_brief}}</view>
                                <view class='price-container'>
                                    <view class='l'>
                                        <view class='h'>￥{{item.has_coupon_promo ? item.promo_price : item.min_retail_price}}</view>
                                        <view class='promo-origin' wx:if="{{item.has_coupon_promo}}">￥{{item.original_price}}</view>
                                        <view class='promo-tag' wx:if="{{item.has_coupon_promo && item.promo_tag}}">{{item.promo_tag}}</view>
                                    </view>
                                </view>
                            </view>
                        </navigator>
                    </view>
                </view>
                <view class="show-more load-more-trigger" wx:if="{{showNoMore == 1}}" bindtap="onBottom">
                    {{isLoadingMore ? '正在加载更多...' : '下滑到底自动加载更多'}}
                </view>
                <view class="no-more" wx:else>没有更多商品了</view>
                <view class="ui-empty-wrap" wx:if="{{uiV2 && list.length == 0}}">
                    <van-empty description="暂无商品"></van-empty>
                </view>
            </block>
            <block wx:else>
                <view class="loading-wrap" wx:if="{{!uiV2}}">
                    <image lazy-load="true" class="img" src="https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/loading.png"></image>
                    <view class="text">正在加载中</view>
                </view>
                <view class="ui-loading-wrap" wx:if="{{uiV2}}">
                    <van-loading size="28px" color="#e74f72" />
                    <view class="ui-loading-text">正在加载分类数据</view>
                </view>
            </block>
        </scroll-view>
    </view>
</view>
