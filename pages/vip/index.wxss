page {
    min-height: 100%;
    background: linear-gradient(180deg, #0c0f15 0rpx, #141922 220rpx, #f3f4f8 440rpx, #f3f4f8 100%);
}

.vip-page {
    min-height: 100%;
    padding: 24rpx 24rpx 220rpx;
    box-sizing: border-box;
}

.loading-text {
    padding: 40rpx 0;
    text-align: center;
    font-size: 26rpx;
    color: #d7d9de;
}

.error-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20rpx;
    padding: 16rpx 20rpx;
    border-radius: 16rpx;
    background: #fff3f1;
    color: #d93025;
    font-size: 24rpx;
}

.retry-btn {
    margin-left: 16rpx;
    border-radius: 999rpx;
}

.hero-card {
    position: relative;
    overflow: hidden;
    border-radius: 28rpx;
    padding: 26rpx 26rpx 30rpx;
    margin-bottom: 20rpx;
    background:
        radial-gradient(circle at 85% 20%, rgba(255, 210, 162, 0.35), rgba(255, 210, 162, 0) 45%),
        linear-gradient(135deg, #090b11, #181f2c);
    box-shadow: 0 20rpx 48rpx rgba(0, 0, 0, 0.35);
}

.hero-card::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 120rpx;
    background: linear-gradient(180deg, rgba(254, 189, 120, 0), rgba(254, 189, 120, 0.12));
}

.hero-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hero-tabs {
    display: flex;
    align-items: center;
}

.hero-tab {
    margin-right: 36rpx;
    color: rgba(255, 231, 198, 0.68);
    font-size: 28rpx;
}

.hero-tab-active {
    color: #ffe9c8;
    font-weight: 600;
    position: relative;
}

.hero-tab-active::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -10rpx;
    margin: 0 auto;
    width: 52rpx;
    height: 6rpx;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #ffdb9f, #ffb86b);
}

.hero-status {
    padding: 6rpx 16rpx;
    border-radius: 999rpx;
    font-size: 22rpx;
    color: #f7ce9a;
    background: rgba(255, 210, 162, 0.16);
}

.hero-status-active {
    color: #2b1c07;
    background: linear-gradient(135deg, #f9dfb7, #ffbf72);
}

.hero-title {
    position: relative;
    z-index: 1;
    margin-top: 42rpx;
    font-size: 58rpx;
    line-height: 1.08;
    font-weight: 700;
    color: #ffddb0;
}

.hero-save-line {
    position: relative;
    z-index: 1;
    margin-top: 12rpx;
    color: #f8d5a5;
    font-size: 34rpx;
}

.hero-save-amount {
    margin-left: 8rpx;
    font-size: 56rpx;
    font-weight: 700;
    color: #fff2dc;
}

.hero-expire {
    position: relative;
    z-index: 1;
    margin-top: 10rpx;
    color: rgba(255, 228, 194, 0.75);
    font-size: 22rpx;
}

.hero-sub {
    position: relative;
    z-index: 1;
    margin-top: 6rpx;
    color: rgba(255, 228, 194, 0.82);
    font-size: 24rpx;
}

.hero-badge {
    position: absolute;
    right: 18rpx;
    bottom: 24rpx;
    z-index: 1;
    width: 132rpx;
    height: 132rpx;
    border-radius: 26rpx;
    border: 2rpx solid rgba(255, 208, 146, 0.45);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 36rpx;
    letter-spacing: 4rpx;
    color: rgba(255, 220, 169, 0.9);
    background: radial-gradient(circle at 30% 30%, rgba(255, 230, 190, 0.36), rgba(255, 190, 115, 0.1));
}

.section-card {
    background: #fff;
    border-radius: 24rpx;
    padding: 24rpx;
    margin-bottom: 20rpx;
    box-shadow: 0 8rpx 22rpx rgba(20, 26, 34, 0.06);
}

.section-title {
    font-size: 32rpx;
    font-weight: 600;
    color: #252833;
    margin-bottom: 16rpx;
}

.benefit-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
}

.benefit-item {
    width: 48%;
    min-height: 110rpx;
    border-radius: 16rpx;
    padding: 16rpx;
    box-sizing: border-box;
    margin-bottom: 14rpx;
    background: linear-gradient(135deg, #fff8ec, #fff2df);
    border: 1rpx solid #f6e3c5;
}

.benefit-index {
    width: 34rpx;
    height: 34rpx;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #f6be76, #eb944b);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 20rpx;
    margin-bottom: 10rpx;
}

.benefit-text {
    font-size: 24rpx;
    line-height: 34rpx;
    color: #5a4a34;
}

.plan-scroll {
    width: 100%;
    white-space: nowrap;
}

.plan-track {
    display: inline-flex;
    padding-bottom: 8rpx;
}

.plan-item {
    position: relative;
    width: 248rpx;
    min-height: 270rpx;
    margin-right: 14rpx;
    border-radius: 18rpx;
    padding: 20rpx;
    box-sizing: border-box;
    border: 2rpx solid #f0e6d8;
    background: #fffdfa;
}

.plan-item-active {
    border-color: #f3b062;
    background: linear-gradient(180deg, #fff7ea, #fff3de);
    box-shadow: 0 14rpx 28rpx rgba(226, 150, 62, 0.2);
}

.plan-gift {
    position: absolute;
    top: -12rpx;
    left: 14rpx;
    height: 34rpx;
    line-height: 34rpx;
    border-radius: 999rpx;
    padding: 0 12rpx;
    font-size: 20rpx;
    color: #fff;
    background: linear-gradient(90deg, #ff4468, #ff6a4d);
}

.plan-tag {
    display: inline-flex;
    padding: 4rpx 12rpx;
    border-radius: 999rpx;
    background: #ffe7bf;
    color: #9b5e17;
    font-size: 20rpx;
    margin-top: 12rpx;
}

.plan-name {
    margin-top: 12rpx;
    color: #2d2f35;
    font-size: 30rpx;
    font-weight: 600;
    line-height: 1.25;
}

.plan-price-line {
    margin-top: 12rpx;
    display: flex;
    align-items: flex-end;
}

.plan-price-unit {
    margin-right: 4rpx;
    color: #d6463f;
    font-size: 24rpx;
    line-height: 1.4;
}

.plan-price-value {
    color: #d6463f;
    font-size: 56rpx;
    line-height: 1;
    font-weight: 700;
}

.plan-monthly {
    margin-top: 8rpx;
    color: #6f747f;
    font-size: 22rpx;
}

.plan-desc {
    margin-top: 8rpx;
    color: #4f5563;
    font-size: 22rpx;
}

.plan-origin {
    margin-top: 6rpx;
    color: #b2b7c1;
    font-size: 20rpx;
    text-decoration: line-through;
}

.agreement-card {
    padding-bottom: 20rpx;
}

.agreement-main {
    display: flex;
    align-items: flex-start;
}

.agreement-check {
    width: 34rpx;
    height: 34rpx;
    border-radius: 999rpx;
    border: 2rpx solid #c9cdd8;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 2rpx;
    margin-right: 14rpx;
}

.agreement-check-on {
    border-color: #ff7f48;
    background: #ff7f48;
}

.agreement-check-mark {
    color: #fff;
    font-size: 20rpx;
    line-height: 1;
}

.agreement-content {
    flex: 1;
}

.agreement-title {
    font-size: 28rpx;
    color: #262b35;
    font-weight: 600;
}

.agreement-text {
    margin-top: 8rpx;
    color: #6b7280;
    font-size: 23rpx;
    line-height: 34rpx;
}

.agreement-tip {
    margin-top: 14rpx;
    color: #8f95a3;
    font-size: 22rpx;
}

.bottom-action {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(255, 255, 255, 0.98);
    border-top: 1rpx solid #eceef4;
    padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    z-index: 99;
}

.bottom-price {
    min-width: 230rpx;
    margin-right: 16rpx;
}

.bottom-plan {
    color: #6b7280;
    font-size: 22rpx;
    line-height: 1.3;
}

.bottom-amount {
    margin-top: 6rpx;
    color: #d6463f;
    font-size: 42rpx;
    line-height: 1;
    font-weight: 700;
}

.bottom-submit {
    flex: 1;
    height: 84rpx;
    line-height: 84rpx;
    border-radius: 999rpx;
    background: linear-gradient(90deg, #14161e, #f0c89a);
    color: #fff;
    font-size: 30rpx;
    font-weight: 600;
}

.bottom-submit::after {
    border: none;
}
