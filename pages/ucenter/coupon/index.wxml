<view class="container">
  <view class="tab-bar">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{status === item.key ? 'active' : ''}}"
      data-status="{{item.key}}"
      bindtap="switchTab"
    >
      {{item.label}}
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>
  <view wx:if="{{!loading && list.length === 0}}" class="empty">暂无优惠券</view>

  <view wx:for="{{list}}" wx:key="user_coupon_id" class="coupon-card">
    <view class="name">{{item.name}}</view>
    <view class="rule" wx:if="{{item.type === 'full_reduction'}}">
      满{{item.threshold_amount}}减{{item.reduce_amount}}
    </view>
    <view class="rule" wx:else>
      满{{item.threshold_amount}}打{{item.discount_rate}}折，封顶{{item.discount_max_reduce}}
    </view>
    <view class="time">领取：{{item.claim_time_text}}</view>
    <view class="time">有效期至：{{item.expire_time_text}}</view>
    <view class="time" wx:if="{{item.used_time_text !== '-' }}">使用：{{item.used_time_text}}</view>
  </view>
</view>
