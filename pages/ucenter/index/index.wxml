<view class="container {{uiV2 ? 'ui-v2' : ''}}">
    <view class="userinfo">
        <view class='head-wrap' wx:if="{{hasUserInfo == false}}" bindtap='handleLoginTap'>
            <view class="no-login-avatar">
                <view class='no-avatar'>
                    <image lazy-load="true" class='avatar' src="/images/icon/default_avatar_big.png"></image>
                </view>
                <van-button wx:if="{{uiV2}}" class='btn-login-v2' round type="danger" color="linear-gradient(135deg,#e74f72,#cf3a5d)" size="small">点我登录</van-button>
                <view wx:if="{{!uiV2}}" class='btn-login'>点我登录</view>
            </view>
        </view>
        <view class='head-wrap' wx:else bindtap='goProfile'>
            <view class="head-l">
                <view class='l'>
                    <image lazy-load="true" class='avatar' src="{{avatarDisplayUrl}}"></image>
                </view>
                <view class='r'>
                    <view class='t'>
                        <view class='name'>{{userInfo.nickname}}</view>
                    </view>
                </view>
            </view>
            <view class="head-r">
                <view class="arrow"></view>
            </view>
        </view>
    </view>
    <view class="order-container {{uiV2 ? 'ui-card' : ''}}">
        <view class='header' data-index='0' bindtap='toOrderListTap'>
            <view class='top-title'>
                <view class='left-line'></view>
                <view class='text'>我的订单</view>
            </view>
            <view class='see-more'>
                <view class="text">查看全部订单</view>
                <view class="arrow"></view>
            </view>
        </view>
        <view class='btn-container'>
            <view class='icon-wrap' data-index='1' bindtap='toOrderListTap'>
                <view class='order-icon-wrap'>
                    <image lazy-load="true" class='order-icon' src='https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-pay-r.png'></image>
                    <van-tag wx:if="{{uiV2 && status.toPay > 0}}" class='red-point-v2' type="danger" round>{{status.toPay}}</van-tag>
                    <view wx:if="{{!uiV2 && status.toPay > 0 }}" class='red-point'>{{status.toPay}}</view>
                </view>
                <text class='order-txt'>待付款</text>
            </view>
            <view class='icon-wrap' data-index='2' bindtap='toOrderListTap'>
                <view class='order-icon-wrap'>
                    <image lazy-load="true" class='order-icon' src='https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-delivery-r.png'></image>
                    <van-tag wx:if="{{uiV2 && status.toDelivery > 0}}" class='red-point-v2' type="danger" round>{{status.toDelivery}}</van-tag>
                    <view wx:if="{{!uiV2 && status.toDelivery > 0 }}" class='red-point'>{{status.toDelivery}}</view>
                </view>
                <text class='order-txt'>待发货</text>
            </view>
            <view class='icon-wrap' data-index='3' bindtap='toOrderListTap'>
                <view class='order-icon-wrap'>
                    <image lazy-load="true" class='order-icon' src='https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-onroad-r.png'></image>
                    <van-tag wx:if="{{uiV2 && status.toReceive > 0}}" class='red-point-v2' type="danger" round>{{status.toReceive}}</van-tag>
                    <view wx:if="{{!uiV2 && status.toReceive > 0 }}" class='red-point'>{{status.toReceive}}</view>
                </view>
                <text class='order-txt'>待收货</text>
            </view>
        </view>
    </view>

    <block wx:if="{{!uiV2}}">
        <view class="li-wrap">
            <view class="list" bindtap="toAddressList">
                <view class="list-l">
                    <view class="icon">
                        <image lazy-load="true" class="img" src="https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-address-r.png"></image>
                    </view>
                    <view class="text">地址管理</view>
                </view>
                <view class="arrow"></view>
            </view>
        </view>
        <view class="li-wrap">
        <view class="list" bindtap="toFootprint">
            <view class="list-l">
                <view class="icon">
                    <image lazy-load="true" class="img" src="https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-footprint-r.png"></image>
                </view>
                <view class="text">我的足迹</view>
            </view>
            <view class="arrow"></view>
        </view>
        <view class="list" bindtap="toCoupon">
            <view class="list-l">
                <view class="icon">
                    <image lazy-load="true" class="img" src="/images/icon/icon-coupon-local.png"></image>
                </view>
                <view class="text">我的优惠券</view>
            </view>
            <view class="arrow"></view>
        </view>
        <view class="list" bindtap="toCouponCenter">
            <view class="list-l">
                <view class="icon">
                    <image lazy-load="true" class="img" src="https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-address-r.png"></image>
                </view>
                <view class="text">领券中心</view>
            </view>
            <view class="arrow"></view>
        </view>
        <view class="list" bindtap="toInvite">
            <view class="list-l">
                <view class="icon">
                    <image lazy-load="true" class="img" src="/images/icon/icon-invite-local.png"></image>
                </view>
                <view class="text">邀请有礼</view>
            </view>
            <view class="arrow"></view>
        </view>
        <view class="list" bindtap="toAdMessage">
            <view class="list-l">
                <view class="icon">
                    <image lazy-load="true" class="img" src="/images/icon/icon-ad-message-local.png"></image>
                </view>
                <view class="text">广告消息</view>
                <view class="message-badge" wx:if="{{adUnreadCount > 0}}">{{adUnreadCount > 99 ? '99+' : adUnreadCount}}</view>
            </view>
            <view class="arrow"></view>
        </view>
        <button class="contact-btn" session-from='{"nickName":"{{userInfo.nickname}}","avatarUrl":"{{userInfo.avatar}}"}' open-type="contact">
            <view class="list-l">
                <view class="icon">
                        <image lazy-load="true" class="img" src="https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-service-r.png"></image>
                    </view>
                    <view class="text">联系客服</view>
                </view>
                <view class="arrow"></view>
            </button>
            <view class="list" bindtap="toAbout">
                <view class="list-l">
                    <view class="icon">
                        <image lazy-load="true" class="img" src="https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-about-r.png"></image>
                    </view>
                    <view class="text">关于我们</view>
                </view>
                <view class="arrow"></view>
            </view>
            <view class="list" bindtap="toDebugNetwork">
                <view class="list-l">
                    <view class="icon">
                        <image lazy-load="true" class="img" src="https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/icon-service-r.png"></image>
                    </view>
                    <view class="text">网络诊断</view>
                </view>
                <view class="arrow"></view>
            </view>
        </view>
    </block>

    <van-cell-group inset wx:if="{{uiV2}}">
        <van-cell title="地址管理" is-link bindtap="toAddressList" />
        <van-cell title="我的足迹" is-link bindtap="toFootprint" />
        <van-cell title="我的优惠券" is-link bindtap="toCoupon" />
        <van-cell title="领券中心" is-link bindtap="toCouponCenter" />
        <van-cell title="邀请有礼" is-link bindtap="toInvite" />
        <van-cell title="广告消息" value="{{adUnreadCount > 0 ? (adUnreadCount > 99 ? '99+' : adUnreadCount) : ''}}" is-link bindtap="toAdMessage" />
        <button class="contact-btn-v2" session-from='{"nickName":"{{userInfo.nickname}}","avatarUrl":"{{userInfo.avatar}}"}' open-type="contact">联系客服</button>
        <van-cell title="关于我们" is-link bindtap="toAbout" />
        <van-cell title="网络诊断" is-link bindtap="toDebugNetwork" />
    </van-cell-group>

    <view class="company">
        <view class="c-wrap" bindtap="getOrderInfo">
            <view class="text">海风小店</view>
            <view class="line"></view>
        </view>
        <view class="tip">美妆好物 甄选优品</view>
    </view>

    <login-profile-sheet
      visible="{{showLoginProfileSheet}}"
      initialProfile="{{userInfo}}"
      requiredPhone="{{true}}"
      requiredNickname="{{true}}"
      bind:success="onProfileSheetSuccess"
      bind:cancel="onProfileSheetCancel"
    />
</view>
