page {
  background: #f5f5f5;
}

.container {
  min-height: 100%;
  padding: 20rpx;
  box-sizing: border-box;
}

.tab-row {
  display: flex;
  background: #fff;
  border-radius: 14rpx;
  overflow: hidden;
  margin-bottom: 18rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  font-size: 26rpx;
  color: #666;
  padding: 18rpx 0;
}

.tab-item--active {
  color: #ff3456;
  font-weight: 600;
  background: #fff5f7;
}

.error-box,
.loading-box,
.empty {
  background: #fff;
  border-radius: 14rpx;
  padding: 24rpx;
  text-align: center;
  color: #666;
}

.error-box button {
  margin-top: 16rpx;
}

.card {
  background: #fff;
  border-radius: 14rpx;
  margin-bottom: 14rpx;
  padding: 20rpx;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  font-size: 28rpx;
  color: #222;
  font-weight: 600;
}

.status {
  font-size: 22rpx;
  color: #ff3456;
}

.meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #777;
}
