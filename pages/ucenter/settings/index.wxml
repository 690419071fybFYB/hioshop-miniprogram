<view class="container">
  <view class="profile-card">
    <image class="avatar" src="{{avatarDisplayUrl}}"></image>
    <view class="meta">
      <view class="title">个人资料</view>
      <view class="subtitle">用于下单与售后联系</view>
    </view>
  </view>

  <view class="info-card">
    <view class="info-row">
      <text class="label">昵称</text>
      <text class="value">{{nickName || '未设置'}}</text>
    </view>
    <view class="divider"></view>
    <view class="info-row">
      <text class="label">手机号</text>
      <text class="value">{{mobileDisplay}}</text>
    </view>
  </view>

  <button class="btn-primary" bindtap="openProfileSheet">完善资料</button>
  <button wx:if="{{isLoggedIn}}" class="btn-logout" bindtap="handleLogout">退出登录</button>
  <button class="btn-secondary" bindtap="goBack">返回</button>

  <login-profile-sheet
    visible="{{showLoginProfileSheet}}"
    initialProfile="{{profileForSheet}}"
    requiredPhone="{{true}}"
    requiredNickname="{{true}}"
    bind:success="onProfileSheetSuccess"
    bind:cancel="onProfileSheetCancel"
  />
</view>
