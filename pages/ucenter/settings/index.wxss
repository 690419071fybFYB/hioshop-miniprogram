page {
  min-height: 100%;
  background: #f7f8fa;
}

.container {
  padding: 28rpx 24rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.profile-card {
  background: #ffffff;
  border-radius: 24rpx;
  border: 1rpx solid #f0e2e7;
  box-shadow: 0 8rpx 24rpx rgba(209, 70, 103, 0.08);
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
}

.avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  border: 2rpx solid #ffe1ea;
  background: #fff;
}

.meta {
  margin-left: 20rpx;
}

.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #222b38;
  line-height: 46rpx;
}

.subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8a6f79;
}

.info-card {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 0 24rpx;
  border: 1rpx solid #f2e5e9;
}

.info-row {
  min-height: 98rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  font-size: 28rpx;
  color: #545f70;
}

.value {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f2533;
  max-width: 420rpx;
  text-align: right;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.divider {
  height: 1rpx;
  background: #f2edf0;
}

.btn-primary,
.btn-secondary,
.btn-logout {
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 46rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.btn-primary {
  margin-top: 32rpx;
  background: linear-gradient(135deg, #e95579, #cf3a5d);
  color: #fff;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  margin-top: 16rpx;
  background: #fff;
  color: #7b6a71;
  border: 1rpx solid #ebdde2;
}

.btn-logout {
  margin-top: 16rpx;
  background: #fff;
  color: #e2496e;
  border: 1rpx solid #f2c7d3;
}
