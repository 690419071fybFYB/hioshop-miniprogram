<view class="container {{uiV2 ? 'ui-v2' : ''}}" wx:if="{{loading == 1}}">
    <view class="popup-ad-mask" wx:if="{{showPopupAd}}" bindtap="closePopupAd"></view>
    <view class="popup-ad-wrap" wx:if="{{showPopupAd}}" bindtap="stopPopupTap">
        <view class="popup-ad-card">
            <view class="popup-ad-media">
                <image class="popup-ad-image" src="{{popupAd.image_url}}" mode="aspectFill" bindtap="handlePopupAdJump"></image>
                <view class="popup-title-badge" wx:if="{{popupAd.title}}">{{popupAd.title}}</view>
                <view class="popup-close-fab" catchtap="closePopupAd">
                    <text class="popup-close-icon">×</text>
                </view>
                <checkbox-group class="popup-dontshow-chip" bindchange="onPopupDontShowChange">
                    <label class="popup-checkbox-label">
                        <checkbox class="popup-checkbox" value="1" checked="{{popupDontShowToday}}" color="#ff3456" />
                        <text class="popup-checkbox-text">今日不再出现</text>
                    </label>
                </checkbox-group>
            </view>
        </view>
    </view>
    <view class="ui-error-card" wx:if="{{hasError && uiV2}}">
        <text class="ui-error-text">{{errorMessage}}</text>
        <van-button size="small" type="danger" plain bindtap="retryLoad">重试</van-button>
    </view>
    <view wx:if="{{hasError && !uiV2}}" style="padding:16rpx 24rpx;background:#fff7f7;color:#d93025;font-size:24rpx;">
        <text>{{errorMessage}}</text>
        <button size="mini" bindtap="retryLoad" style="margin-left:16rpx;">重试</button>
    </view>
    <view class='contact-wrap' wx:if="{{showContact == 1}}">
        <button class="contact-btn" session-from='{"nickName":"{{userInfo.nickname}}","avatarUrl":"{{userInfo.avatar}}"}' open-type="contact">
            <image lazy-load="true" class='icon' src='/images/icon/contact.png'></image>
            <view class='text'>客服</view>
        </button>
    </view>
    <view class="search" bindtap="goSearch">
        <image lazy-load="true" class="icon" src="/images/icon/search.png"></image>
        <text class="txt">搜索,发现更多好物</text>
    </view>
    <swiper
      class="catalog-wrap"
      indicator-dots="{{false}}"
      indicator-color="#dedede"
      indicator-active-color="#e00000"
      wx:if="{{show_channel}}"
      bindchange="onCatalogSwiperChange"
    >
        <swiper-item class="first">
            <view wx:for="{{channel}}" wx:if="{{item.sort_order < 7}}" wx:key="id" class='icon-navi' data-cateid="{{item.id}}" bindtap="goCategory">
                <image lazy-load="true" class='icon-img' src="{{item.icon_url}}"></image>
                <view class='icon-text'>{{item.name}}</view>
            </view>
        </swiper-item>
        <swiper-item class="first" wx:if="{{channel.length > 6}}">
            <navigator wx:for="{{channel}}" wx:key="id" hover-class="none" class='icon-navi' url="/pages/category/index?id={{item.id}}" wx:if="{{item.sort_order > 6 && item.sort_order < 12}}">
                <image lazy-load="true" class='icon-img' src="{{item.icon_url}}"></image>
                <view class='icon-text'>{{item.name}}</view>
            </navigator>
        </swiper-item>
        <swiper-item class="first" wx:if="{{channel.length > 11}}">
            <navigator wx:for="{{channel}}" hover-class="none" class='icon-navi' url="/pages/category/index?id={{item.id}}" wx:if="{{item.sort_order > 10}}">
                <image lazy-load="true" class='icon-img' src="{{item.icon_url}}"></image>
                <view class='icon-text'>{{item.name}}</view>
            </navigator>
        </swiper-item>
    </swiper>
    <view class="catalog-page-hint" wx:if="{{show_channel && catalogPageCount > 1}}">
      <view class="catalog-dots">
        <view wx:for="{{catalogPages}}" wx:key="*this" class="catalog-dot {{item === currentCatalogPage ? 'active' : ''}}"></view>
      </view>
    </view>
    <view class='banner-wrap' wx:if="{{show_banner && banner.length > 0}}">
        <swiper class="banner" indicator-dots="true" autoplay="{{autoplay}}" interval="3000" duration="1000"   >
            <swiper-item wx:for="{{banner}}" wx:key="id">
                <navigator wx:if="{{item.link_type == 0}}" url="/pages/goods/goods?id={{item.goods_id}}">
                    <image lazy-load="true" src="{{item.image_url}}" mode="aspectFill" background-size="cover"></image>
                </navigator>
                <navigator wx:elif="{{item.link_type == 1}}" url="{{item.link}}">
                    <image lazy-load="true" src="{{item.image_url}}" mode="aspectFill" background-size="cover"></image>
                </navigator>
            </swiper-item>
        </swiper>
    </view>
    <view class='marquee_box' wx:if="{{notice.length>0 && show_notice == 1}}">
        <swiper vertical="{{true}}" class="notice-swiper" indicator-dots="{{false}}" autoplay="{{autoplay}}" interval="2000" duration="1000">
            <swiper-item wx:for="{{notice}}" wx:key="id" class='notice-wrap'>

                    <view class="icon">
                        <image lazy-load="true" src="/images/icon/notice-icon.png" class='img'>
                        </image>
                    </view>
                    <view class='notice-text'>{{item.content}}</view>

            </swiper-item>
        </swiper>
    </view>
    <view class="coupon-zone" wx:if="{{couponLoading || couponSectionReady || couponNeedLogin}}">
        <view class="coupon-zone-head">
            <view class="coupon-zone-title">限时领券</view>
            <view class="coupon-zone-more" bindtap="toCouponCenter">查看更多</view>
        </view>
        <view class="coupon-loading" wx:if="{{couponLoading}}">优惠券加载中...</view>
        <view class="coupon-empty" wx:elif="{{couponList.length === 0}}">
            <view class="coupon-empty-text">当前暂无可领取优惠券</view>
        </view>
        <scroll-view wx:else class="coupon-scroll" scroll-x="true" enable-flex="true">
            <view class="coupon-item {{item.has_received ? 'received' : ''}}" wx:for="{{couponList}}" wx:key="id">
                <view class="coupon-amount">{{item.amountText}}</view>
                <view class="coupon-limit">{{item.limitText}}</view>
                <view class="coupon-rule">{{item.ruleText}}</view>
                <button
                    class="coupon-btn"
                    size="mini"
                    type="{{item.actionDisabled ? 'default' : 'warn'}}"
                    plain="{{item.has_received}}"
                    disabled="{{item.actionDisabled}}"
                    data-id="{{item.id}}"
                    bindtap="receiveCouponFromHome"
                >
                    {{item.actionText}}
                </button>
                <view class="coupon-login-tip" wx:if="{{item.needLoginToReceive && !item.actionDisabled}}">
                    登录后可领取
                </view>
            </view>
        </scroll-view>
    </view>
    <!-- <ad unit-id="adunit-c755904541658aa1" ad-type="grid" grid-opacity="0.8" grid-count="5" ad-theme="white"></ad> -->
    <view class="goods-container">
        <view class='topic-container' wx:for="{{floorGoods}}" wx:key="id">
            <view class='banner-container' bindtap="goCategory" data-cateid="{{item.id}}" wx:if="{{index_banner_img == 1}}">
                <image lazy-load="true" mode='aspectFill' style="width:100%;height:{{item.height}}rpx" src='{{item.banner}}'>
                </image>
                <view class="bg" style="height:{{item.height}}rpx;line-height:{{item.height}}rpx;"></view>
                <view class="text" style="height:{{item.height}}rpx;line-height:{{item.height}}rpx;">{{item.name}}</view>
            </view>
            <view wx:else class="category-title" data-cateid="{{item.id}}" bindtap="goCategory">
                <view class="title">
                    <view class="text">{{item.name}}</view>
                    <view class="line"></view>
                </view>
            </view>
            <view class='list-wrap clearfix'>
                <view class="new-box {{(iindex+1)%3 == 0?'no-margin':''}}" wx:for="{{item.goodsList}}" wx:for-index="iindex" wx:for-item="iitem" wx:key="id">
                    <navigator hover-class='none' class='navi-url' url="/pages/goods/goods?id={{iitem.id}}">
                        <view class="box">
                            <image lazy-load="true" src="{{iitem.list_pic_url}}" class="image"></image>
                            <van-tag wx:if="{{uiV2 && iitem.isHotSale}}" class='new-tag hot-tag' type="danger">{{iitem.hotTagText}}</van-tag>
                            <van-tag wx:elif="{{uiV2 && iitem.is_new == 1}}" class='new-tag' type="danger" plain>新品</van-tag>
                            <view wx:if="{{!uiV2 && iitem.isHotSale}}" class='new-tag hot-tag'>{{iitem.hotTagText}}</view>
                            <view wx:elif="{{!uiV2 && iitem.is_new == 1}}" class='new-tag'>新品</view>
                            <block wx:if="{{iitem.goods_number <= 0}}">
                                <view class='sold-img'>
                                    <image lazy-load="true" class='soldout' src='/images/icon/sold-out.png'></image>
                                </view>
                            </block>
                        </view>
                            <view class="goods-info {{iitem.goods_number <= 0?'fast-out-status':''}}">
                                <view class="goods-title">{{iitem.name}}</view>
                                <view class='price-container'>
                                    <view class='l'>
                                        <view class="promo-line">
                                            <view class='h'>￥{{iitem.displayPrice || iitem.min_retail_price}}</view>
                                            <view class='promo-origin' wx:if="{{iitem.hasPromotion}}">￥{{iitem.displayOriginalPrice}}</view>
                                        </view>
                                        <view class='promo-tag' wx:if="{{iitem.hasPromotion && iitem.displayPromotionTag}}">{{iitem.displayPromotionTag}}</view>
                                        <view class='promo-countdown' wx:if="{{iitem.hasPromotion && iitem.promotionCountdownText}}">{{iitem.promotionCountdownText}}</view>
                                    </view>
                                </view>
                            </view>
                    </navigator>
                </view>
            </view>
            <view class="more-category" data-cateid="{{item.id}}" bindtap="goCategory">点击查看更多{{item.name}}</view>
        </view>
    </view>
    <!-- <ad unit-id="adunit-b6fcdb43b7913591"></ad> -->
    <view class="no-more-goods ">没有更多商品啦</view>
</view>
<view class="loading" style="height:{{sysHeight}}px" wx:else>
    <view class="ui-loading-wrap" wx:if="{{uiV2}}">
        <van-loading size="28px" color="#e74f72" />
        <view class="ui-loading-text">正在加载首页内容</view>
    </view>
    <block wx:else>
        <image lazy-load="true" class="img" src="https://fybshopbk-1369967353.cos.ap-shanghai.myqcloud.com/images/icon/loading.png"></image>
        <view class="text">正在加载中</view>
    </block>
</view>
