/**index.wxss**/

.container {
    background-color: #fff;
    min-height: 100%;
    align-items: stretch;
    overflow-x: hidden;
    position: relative;
}

.loading {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    flex-direction: column;
}

.loading .img {
    width: 90rpx;
    height: 90rpx;
}

.loading .text {
    margin-top: 20rpx;
    width: 100%;
    font-size: 24rpx;
    color: #999;
    text-align: center;
}

.qrcode-img {
    width: 600rpx;
    height: 600rpx;
}

.contact-wrap {
    position: fixed;
    z-index: 9;
    right: 30rpx;
    bottom: 60rpx;
    box-shadow: 2rpx 4rpx 10rpx #f1f1f1;
    color: #999;
    border-radius: 10rpx;
}

.contact-wrap .contact-btn {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 130rpx;
    opacity: 0.9;
    background: #fff;
}

.contact-wrap .icon-mask {
    background: #000;
    opacity: 0.9;
}

.contact-wrap .contact-btn:after {
    border: none;
}

.contact-wrap .contact-btn .icon {
    width: 50rpx;
    height: 50rpx;
    margin: 0 auto;
    margin-top: 20rpx;
}

.contact-wrap .contact-btn .text {
    font-size: 22rpx;
    text-align: center;
}

.black-mask {
    width: 100%;
    height: 2000rpx;
    position: fixed;
    top: 0;
    left: 0;
    background: #333;
    opacity: 0.5;
    z-index: 99;
}

.mask {
    width: 100%;
    height: 1000rpx;
    position: fixed;
    top: 0;
    left: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 999;
}

.search {
    height: 100rpx;
    width: 100%;
    padding: 0 12rpx;
    background: #f9f9f9;
    display: flex;
    justify-content: flex-start;
    align-items: center;
    box-sizing: border-box;
}

.search .icon {
    width: 30rpx;
    height: 30rpx;
}

.search .txt {
    height: 42rpx;
    line-height: 42rpx;
    color: #666;
    padding-left: 10rpx;
    font-size: 28rpx;
}

.banner-wrap {
    width: calc(100% - 24rpx);
    margin: 0 auto;
    height: 440rpx;
    display: flex;
    justify-content: center;
}

.banner {
    width: 100%;
    height: 440rpx;
}

.banner image {
    width: 100%;
    /* height: 417rpx; */
    height: 440rpx;
}

.marquee_box {
    position: relative;
    display: flex;
    align-items: center;
    height: 80rpx;
    background-color: #fff;
    box-shadow: 1rpx 4rpx 6rpx #f1f1f1;
    /* margin-bottom: 20rpx; */
    padding: 0 12rpx;
}

.notice-swiper {
    width: 100%;
    height: 30rpx;
}

.notice-wrap {
    display: flex;
    justify-content: flex-start;
    height: 80rpx;
}

.notice-wrap .notice-text {
    font-size: 24rpx;
}

.notice-wrap .icon {
    width: 30rpx;
    height: 30rpx;
    margin-right: 10rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.notice-wrap .icon .img {
    width: 30rpx;
    height: 30rpx;
}

.catalog-wrap {
    margin: 12rpx 0 0;
    width: 100%;
    height: 144rpx;
    box-sizing: border-box;
}

.catalog-page-hint {
    padding: 4rpx 0 8rpx;
    display: flex;
    align-items: center;
    justify-content: center;
}

.catalog-dots {
    display: flex;
    align-items: center;
    justify-content: center;
}

.catalog-dot {
    width: 10rpx;
    height: 10rpx;
    border-radius: 10rpx;
    background: #d6d6d6;
    margin: 0 6rpx;
    transition: all .2s ease;
}

.catalog-dot.active {
    width: 20rpx;
    background: #ff3456;
}

.coupon-zone {
    margin: 16rpx 12rpx 8rpx;
    padding: 14rpx 14rpx 12rpx;
    background: linear-gradient(180deg, #fff0f4 0%, #fff8f8 100%);
    border-radius: 14rpx;
}

.promotion-zone {
    margin: 20rpx 24rpx 12rpx;
    padding: 22rpx 20rpx 20rpx;
    border-radius: 20rpx;
    background: linear-gradient(130deg, #ff5a2d 0%, #ff2f67 100%);
}

.promotion-zone-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.promotion-zone-title {
    font-size: 34rpx;
    font-weight: 700;
    color: #fff;
}

.promotion-zone-sub {
    font-size: 22rpx;
    color: rgba(255, 255, 255, 0.86);
}

.promotion-scroll {
    margin-top: 16rpx;
    white-space: nowrap;
}

.promotion-card {
    width: 220rpx;
    margin-right: 14rpx;
    padding: 12rpx;
    border-radius: 14rpx;
    background: #fff;
    display: inline-flex;
    flex-direction: column;
    box-sizing: border-box;
}

.promotion-img-wrap {
    width: 196rpx;
    height: 196rpx;
    position: relative;
    border-radius: 10rpx;
    overflow: hidden;
    background: #f5f5f5;
}

.promotion-img {
    width: 196rpx;
    height: 196rpx;
}

.promotion-tag {
    position: absolute;
    left: 10rpx;
    top: 10rpx;
    max-width: 160rpx;
    padding: 4rpx 10rpx;
    border-radius: 999rpx;
    font-size: 18rpx;
    color: #fff;
    background: rgba(0, 0, 0, 0.58);
}

.promotion-name {
    margin-top: 10rpx;
    font-size: 24rpx;
    color: #222;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.promotion-price-row {
    margin-top: 6rpx;
    display: flex;
    align-items: flex-end;
}

.promotion-price {
    font-size: 30rpx;
    color: #ff3456;
    font-weight: 700;
}

.promotion-origin {
    margin-left: 8rpx;
    font-size: 20rpx;
    color: #999;
    text-decoration: line-through;
}

.promotion-countdown {
    margin-top: 6rpx;
    font-size: 20rpx;
    color: #666;
}

.promotion-progress {
    margin-top: 8rpx;
    width: 100%;
    height: 10rpx;
    border-radius: 999rpx;
    background: #ffe5ea;
    overflow: hidden;
}

.promotion-progress-inner {
    height: 10rpx;
    border-radius: 999rpx;
    background: linear-gradient(135deg, #ff5f7b, #fc2f4d);
}

.coupon-zone-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.coupon-zone-title {
    font-size: 30rpx;
    font-weight: 700;
    color: #222;
}

.coupon-zone-more {
    font-size: 22rpx;
    color: #ff3456;
}

.coupon-loading {
    margin-top: 12rpx;
    font-size: 22rpx;
    color: #888;
}

.coupon-empty {
    margin-top: 12rpx;
    padding: 14rpx;
    background: #fff;
    border-radius: 10rpx;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.coupon-empty-text {
    font-size: 22rpx;
    color: #666;
}

.coupon-empty-btn {
    height: 52rpx;
    line-height: 52rpx;
    border-radius: 26rpx;
    font-size: 22rpx;
}

.coupon-scroll {
    margin-top: 12rpx;
    white-space: nowrap;
}

.coupon-item {
    width: 196rpx;
    min-height: 166rpx;
    padding: 14rpx 12rpx 10rpx;
    margin-right: 10rpx;
    display: inline-flex;
    flex-direction: column;
    box-sizing: border-box;
    background: #fff;
    border-radius: 14rpx;
    border: 1rpx solid #ffd7de;
    position: relative;
    overflow: hidden;
}

.coupon-item::after {
    content: "";
    position: absolute;
    left: 10rpx;
    right: 10rpx;
    bottom: 56rpx;
    border-bottom: 1rpx dashed #ffd5de;
}

.coupon-item.received {
    opacity: 0.65;
}

.coupon-amount {
    font-size: 34rpx;
    line-height: 40rpx;
    font-weight: 700;
    color: #ff3456;
}

.coupon-limit {
    margin-top: 4rpx;
    font-size: 20rpx;
    color: #ff3456;
}

.coupon-rule {
    margin-top: 6rpx;
    min-height: 44rpx;
    font-size: 18rpx;
    line-height: 22rpx;
    color: #666;
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}

.coupon-btn {
    margin-top: auto;
    width: 100%;
    height: 46rpx;
    line-height: 46rpx;
    font-size: 20rpx;
    border-radius: 23rpx;
}

.coupon-login-tip {
    margin-top: 6rpx;
    text-align: center;
    font-size: 18rpx;
    color: #9f6a74;
}

.catalog-wrap .first {
    width: 100%;
    box-sizing: border-box;
    padding: 0 12rpx;
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    column-gap: 24rpx;
    row-gap: 16rpx;
}

.catalog-wrap .icon-navi {
    width: 100rpx;
    /* height: 160rpx; */
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.catalog-wrap .icon-img {
    height: 70rpx;
    width: 70rpx;
}

.catalog-wrap .icon-text {
    width: 100%;
    text-align: center;
    font-size: 22rpx;
    margin-top: 10rpx;
}

.no-goods-mask {
    position: absolute;
    left: 0;
    top: 0;
    width: 220rpx;
    height: 220rpx;
    background: #000;
    opacity: 0.3;
}

/* 信息容器 */

.more-category {
    width: 100%;
    text-align: center;
    height: 100rpx;
    line-height: 60rpx;
    font-size: 26rpx;
    color: #666;
}

.list-wrap .new-box {
    width: 226rpx;
    /* height: 330rpx; */
    float: left;
    margin: 0 24rpx 18rpx 0;
}

.new-box .sold-img {
    position: absolute;
    left: 0;
    top: 0;
    width: 226rpx;
    height: 226rpx;
    display: flex;
    justify-content: center;
    align-items: center;
}

.new-box .soldout {
    height: 120rpx;
    width: 120rpx;
}

.new-buy .list-wrap,
.goods-container .list-wrap {
    display: block;
    width: 100%;
    padding: 20rpx 12rpx 6rpx 12rpx;
    height: auto;
    box-sizing: border-box;
}

.list-wrap .no-margin {
    margin-right: 0;
}

.new-box .navi-url {
    width: 100%;
    display: flex;
    flex-direction: column;
}

.new-box .navi-url .image {
    width: 226rpx;
    height: 226rpx;
    border-radius: 8rpx;
    background: #f9f9f9;
}

.new-box .navi-url .box {
    height: 226rpx;
    width: 226rpx;
    position: relative;
    margin-bottom: 10rpx;
    border-radius: 4rpx;
    /* border: 1rpx solid #eee; */
    /* box-sizing: border-box; */
}

.new-box .navi-url .box .new-tag {
    height: 36rpx;
    width: 60rpx;
    background: #ca2a1d;
    position: absolute;
    top: 20rpx;
    left: 0;
    line-height: 36rpx;
    text-align: center;
    font-size: 18rpx;
    color: #fff;
    border-radius: 0 40rpx 40rpx 0;
}

.new-box .navi-url .goods-info .goods-title {
    font-size: 24rpx;
    color: #222;
    margin-bottom: 6rpx;
    display: -webkit-box;
    word-break: break-all;
    text-overflow: ellipsis;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
}

.new-box .navi-url .goods-info .goods-intro {
    font-size: 16rpx;
    color: #888;
    margin-bottom: 6rpx;
    /* height: 64rpx; */
    display: -webkit-box;
    word-break: break-all;
    text-overflow: ellipsis;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 1;
}

.new-box .navi-url .goods-info .price-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.new-box .navi-url .goods-info .price-container .l {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
}

.new-box .navi-url .goods-info .price-container .r {
    width: 46rpx;
    height: 46rpx;
}

.new-box .navi-url .goods-info .price-container .r .cart-img {
    width: 46rpx;
    height: 46rpx;
}

.new-box .navi-url .goods-info .price-container .l .h {
    font-size: 28rpx;
    font-weight: 700;
    color: #e53333;
}

.new-box .navi-url .goods-info .price-container .l .promo-line {
    display: flex;
    align-items: baseline;
    column-gap: 8rpx;
}

.new-box .navi-url .goods-info .price-container .l .promo-origin {
    font-size: 20rpx;
    color: #999;
    text-decoration: line-through;
}

.new-box .navi-url .goods-info .price-container .l .promo-tag {
    display: inline-flex;
    align-items: center;
    box-sizing: border-box;
    max-width: 100%;
    margin-top: 4rpx;
    padding: 0 8rpx;
    line-height: 28rpx;
    font-size: 18rpx;
    color: #ff3456;
    background: #fff1f1;
    border: 1rpx solid #ffd4d4;
    border-radius: 6rpx;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.new-box .navi-url .goods-info .price-container .l .promo-countdown {
    margin-top: 4rpx;
    font-size: 18rpx;
    color: #b24f63;
}

.new-box .navi-url .goods-info .price-container .l .b {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
}

.new-box .navi-url .goods-info .price-container .retail-price {
    font-size: 18rpx;
    color: #000;
    margin-bottom: 4rpx;
    /* font-weight: bold; */
}

.goods-container .topic-container {
    width: 100%;
}

.topic-container .banner-container {
    margin: 0 12rpx;
    display: flex;
    justify-content: center;
    align-items: center;
    position: relative;
}

.banner-container .banner-image-wrap {
    width: 100%;
}

.banner-container image {
    width: 100%;
    /* height: 300rpx; */
    border-radius: 10rpx;
}

.banner-container .text {
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    text-align: center;
    font-size: 30rpx;
    font-weight: 500;
    z-index: 9;
    color: #fff;
}

.banner-container .bg {
    width: 100%;
    position: absolute;
    top: 0;
    left: 0;
    background: #000;
    border-radius: 10rpx;
    opacity: 0.2;
}

.category-title {
    padding: 0 12rpx;
}

.category-title .title {
    width: 100%;
    height: 100rpx;
    border-radius: 8rpx;
    background: #f9f9f9;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.category-title .title .text {
    font-size: 30rpx;
    color: #333;
    font-weight: 500;
    height: 60rpx;
    line-height: 60rpx;
}

.category-title .title .line {
    height: 5rpx;
    width: 30rpx;
    border-radius: 100rpx;
    background: #ff3456;
}

.clearfix:after {
    visibility: hidden;
    display: block;
    font-size: 0;
    content: " ";
    clear: both;
    height: 0;
}

/* 没有更多  */

.no-more-goods {
    text-align: center;
    font-size: 28rpx;
    margin: 20rpx 0 30rpx 0;
    color: #999;
}
/* UI v2 */
.ui-v2 .search {
  margin: 20rpx 12rpx;
  width: auto;
  height: 88rpx;
  background: #fff;
  border-radius: 44rpx;
  box-shadow: var(--shadow-card);
}

.ui-v2 .banner-wrap,
.ui-v2 .banner,
.ui-v2 .banner image {
  border-radius: var(--radius-md);
  overflow: hidden;
}

.ui-v2 .banner-wrap {
  width: calc(100% - 24rpx);
  margin: 0 auto;
  height: 380rpx;
}

.ui-v2 .banner {
  width: 100%;
  height: 100%;
}

.ui-v2 .catalog-wrap {
  margin: 24rpx 0;
}

.ui-v2 .topic-container {
  background: #fff;
  margin: 0 12rpx 16rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-card);
  overflow: hidden;
}

.ui-v2 .new-box .navi-url .image,
.ui-v2 .new-box .navi-url .box {
  border-radius: var(--radius-sm);
}

.ui-v2 .new-box .navi-url .box .new-tag {
  position: absolute;
  left: 12rpx;
  top: 12rpx;
}
