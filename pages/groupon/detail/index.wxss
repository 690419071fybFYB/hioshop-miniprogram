page {
  background: #f5f5f5;
}

.container {
  min-height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
  padding-bottom: 160rpx;
}

.error-box,
.loading-box {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  color: #666;
}

.error-box button {
  margin-top: 16rpx;
}

.hero-card {
  background: #fff;
  border-radius: 18rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.hero-cover {
  width: 100%;
  height: 320rpx;
  background: #f0f0f0;
}

.hero-content {
  padding: 22rpx;
}

.hero-title {
  font-size: 30rpx;
  color: #222;
  font-weight: 600;
}

.hero-meta {
  margin-top: 10rpx;
  color: #888;
  font-size: 24rpx;
}

.hero-price-row {
  margin-top: 10rpx;
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.price-main {
  font-size: 38rpx;
  font-weight: 700;
  color: #ff3456;
}

.price-old {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.team-card {
  background: #fff;
  border-radius: 18rpx;
  margin-bottom: 20rpx;
  padding: 20rpx;
}

.section-title {
  font-size: 28rpx;
  color: #222;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.team-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #666;
}

.member-list {
  margin-top: 12rpx;
}

.member-item {
  font-size: 24rpx;
  color: #555;
  padding: 8rpx 0;
}

.open-team-item {
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f1f1f1;
}

.open-team-item:last-child {
  border-bottom: 0;
}

.action-row {
  margin-top: 16rpx;
}

.btn {
  background: #ff3456;
  color: #fff;
  border: 0;
  font-size: 26rpx;
}

.btn-small {
  margin-top: 10rpx;
  width: 180rpx;
  font-size: 24rpx;
}

.action-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-top: 1rpx solid #f1f1f1;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  display: flex;
  gap: 16rpx;
}

.action-fixed .btn {
  flex: 1;
}

.btn-ghost {
  background: #fff5f7;
  color: #ff3456;
}
