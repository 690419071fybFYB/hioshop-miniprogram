page {
  background: #f5f5f5;
}

.container {
  min-height: 100%;
  padding: 24rpx;
  box-sizing: border-box;
}

.error-box,
.loading-box,
.empty {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  text-align: center;
  color: #666;
}

.error-box button {
  margin-top: 16rpx;
}

.card {
  display: flex;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.cover {
  width: 200rpx;
  height: 200rpx;
  background: #f0f0f0;
}

.content {
  flex: 1;
  padding: 20rpx;
  box-sizing: border-box;
}

.top-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.name {
  flex: 1;
  font-size: 28rpx;
  color: #222;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tag {
  margin-left: 12rpx;
  font-size: 20rpx;
  color: #ff3456;
  background: rgba(255, 52, 86, 0.12);
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.price-main {
  font-size: 34rpx;
  color: #ff3456;
  font-weight: 700;
}

.price-old {
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
}

.group-size {
  font-size: 22rpx;
  color: #666;
}

.meta-row {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #888;
}

.action-row {
  margin-top: 12rpx;
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
}

.btn {
  background: #ff3456;
  color: #fff;
  border: 0;
  line-height: 1.8;
}

.btn-ghost {
  background: #fff5f7;
  color: #ff3456;
}
