<view class='container {{uiV2 ? "ui-v2" : ""}}'>
	<view class="ui-error-card" wx:if="{{hasError && uiV2}}">
		<text class="ui-error-text">{{errorMessage}}</text>
		<van-button size="small" type="danger" plain bindtap="retryLoad">重试</van-button>
	</view>
	<view wx:if="{{hasError && !uiV2}}" style="padding:16rpx 24rpx;background:#fff7f7;color:#d93025;font-size:24rpx;">
		<text>{{errorMessage}}</text>
		<button size="mini" bindtap="retryLoad" style="margin-left:16rpx;">重试</button>
	</view>
	<view class="goodsList" wx:if="{{cartGoods.length > 0}}">
		<view class="a-goods {{item.isTouchMove ? 'touch-move-active' : ''}}" wx:for="{{cartGoods}}" wx:key="id" bindtouchstart="touchstart" bindtouchmove="touchmove" data-index="{{index}}">
			<view class='content'>
				<view wx:if="{{item.number >0 && item.is_on_sale == 1}}" class="checkbox" bindtap="checkedItem" data-item-index="{{index}}">
					<image lazy-load="true" wx:if="{{item.checked == 1}}" class="checkbox-img" src="/images/icon/gou-red.png"></image>
					<image lazy-load="true" wx:else class="checkbox-img" src="/images/icon/gou-gray.png"></image>
				</view>
				<image lazy-load="true" src="/images/icon/gou-gray.png" wx:else class="checkbox"></image>
				<view class="goods-info">
					<view class="goods-url">
						<view class="img-box" bindtap="goGoodsDetail" data-goodsid="{{item.goods_id}}">
							<image lazy-load="true" src="{{item.list_pic_url}}" class="img" />
						</view>
						<view class="text-box">
							<view class="{{item.number >0 && item.is_on_sale == 1?'goods-title':'out-stock-title'}}">{{item.goods_name}}</view>
							<view class="goods-label">{{item.goods_specifition_name_value}}</view>
							<view class="goods-price">
								<view class='price-now'>￥{{item.retail_price}}</view>
							</view>
							<view class="selnum" catchtap="nothing" wx:if="{{item.number > 0 && item.is_on_sale == 1}}">
								<view data-item-index="{{index}}" class="cut" catchtap="cutNumber">-</view>
								<input value="{{item.number}}" class="number" disabled="true" type="number" />
								<view data-item-index="{{index}}" class="add" catchtap="addNumber" disabled='{{disabled}}'>+</view>
							</view>
							<view wx:else class="out-stock">暂时缺货</view>
						</view>
					</view>
				</view>
			</view>
			<view class="delete-btn" data-item-index="{{index}}" catchtap="deleteGoods">
				删除
			</view>
		</view>
	</view>
	<view class="cart-empty-container {{hasCartGoods == 0?'show':''}}" wx:if="{{!uiV2}}">
		<view class='cart-empty-view'>
			<image lazy-load="true" class='cart-empty' src='/images/icon/cart-empty.png'></image>
		</view>
		<view class='cart-empty-txt'>车里什么都没有，快去买一点吧</view>
		<view class="to-index-btn" bindtap="toIndexPage">
			去逛逛
		</view>
	</view>
	<view class="ui-empty-wrap" wx:if="{{uiV2 && hasCartGoods == 0}}">
		<van-empty description="购物车空空如也">
			<van-button round type="danger" size="small" color="linear-gradient(135deg,#e74f72,#cf3a5d)" bindtap="toIndexPage">去逛逛</van-button>
		</van-empty>
	</view>
	<view class="settle-box" wx:if="{{cartGoods.length > 0}}">
		<view class="left-price">
			<view class="all-selected" bindtap="checkedAll">
				<image lazy-load="true" class="checkbox" wx:if="{{checkedAllStatus}}" src="/images/icon/gou-red.png"></image>
				<image lazy-load="true" class="checkbox" wx:else src="/images/icon/gou-gray.png"></image>
				<view class="text">全选({{cartTotal.checkedGoodsCount}})
				</view>
			</view>
			<view class="total" hidden="">合计：¥{{cartTotal.checkedGoodsAmount}}</view>
		</view>
		<van-button wx:if="{{uiV2}}" class="to-pay-btn-v2" round type="danger" color="linear-gradient(135deg,#e74f72,#cf3a5d)" bindtap="checkoutOrder">去结算</van-button>
		<view wx:if="{{!uiV2}}" class="to-pay-btn" hidden="" bindtap="checkoutOrder">去结算</view>
		<!-- <view class="to-pay-btn" hidden="" bindtap="test">去结算</view>    -->
	</view>
</view>
