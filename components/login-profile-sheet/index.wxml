<van-popup
  show="{{visible}}"
  round
  position="bottom"
  close-on-click-overlay="{{false}}"
  z-index="12000"
  custom-style="height: 78vh;"
>
  <view class="sheet">
    <view class="sheet-header">
      <view class="sheet-title">完善登录资料</view>
      <view class="sheet-subtitle">仅需 30 秒，完成后可立即领取优惠券并下单</view>
    </view>

    <view class="sheet-card">
      <view class="avatar-wrap">
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar" src="{{avatarDisplayUrl}}"></image>
          <view class="avatar-edit">更换</view>
        </button>
      </view>

      <view class="form">
        <view class="field">
          <view class="label">昵称</view>
          <view class="input-wrap">
            <input
              class="input"
              type="nickname"
              value="{{nickName}}"
              bindinput="onNickNameInput"
              bindblur="onNickNameBlur"
              placeholder="请输入昵称（必填）"
            />
          </view>
        </view>

        <view class="field phone-field">
          <view class="phone-row">
            <view class="phone-label">手机号：{{mobileMasked}}</view>
            <button
              wx:if="{{!phoneAuthorized}}"
              class="phone-auth-btn"
              open-type="getPhoneNumber"
              bindgetphonenumber="onGetPhoneNumber"
              loading="{{phoneLoading}}"
              disabled="{{phoneLoading}}"
            >
              {{phoneLoading ? '识别中...' : '一键识别'}}
            </button>
            <view wx:else class="phone-authorized">已授权</view>
          </view>

          <view class="phone-helper">
            {{phoneAuthorized ? '已自动识别手机号，如需更换可手动输入' : '点击“一键识别”自动填充手机号'}}
          </view>

          <view wx:if="{{!phoneManualMode}}" class="phone-manual-toggle" bindtap="togglePhoneManualInput">
            {{phoneAuthorized ? '手动更换手机号' : '改为手动输入手机号'}}
          </view>
          <view wx:if="{{phoneManualMode}}" class="phone-manual-collapse" bindtap="togglePhoneManualInput">
            收起手动输入
          </view>

          <view class="input-wrap manual-input-wrap" wx:if="{{phoneManualMode}}">
            <input
              class="input"
              type="number"
              value="{{mobile}}"
              bindinput="onMobileInput"
              maxlength="11"
              placeholder="请输入手机号（必填）"
            />
          </view>
        </view>
      </view>
    </view>

    <view class="actions">
      <button class="submit-btn" loading="{{submitting}}" bindtap="submitProfile">完成登录</button>
      <view class="actions-tip">仅用于下单与售后联系，我们不会公开展示手机号</view>
      <view class="cancel-btn" bindtap="onCancel">稍后再说</view>
    </view>
  </view>
</van-popup>
