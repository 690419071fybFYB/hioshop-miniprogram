<van-popup
  show="{{visible}}"
  round
  position="bottom"
  close-on-click-overlay="{{false}}"
  z-index="12000"
  custom-style="height: 72vh;"
>
  <view class="sheet">
    <view class="sheet-title">完善登录资料</view>
    <view class="sheet-subtitle">仅需头像、昵称、手机号即可完成登录</view>

    <view class="avatar-wrap" bindtap="onTapNicknameField">
      <image class="avatar" src="{{avatarDisplayUrl}}"></image>
      <view class="avatar-tip">点击头像或昵称框，可微信获取/上传头像</view>
    </view>

    <view class="form">
      <view class="field">
        <view class="label">昵称</view>
        <view class="input-wrap">
          <input
            class="input"
            type="nickname"
            value="{{nickName}}"
            bindinput="onNickNameInput"
            bindblur="onNickNameBlur"
            disabled="{{!nicknameManualMode}}"
            focus="{{focusNickname}}"
            placeholder="点击输入框获取微信昵称（必填）"
          />
          <button
            wx:if="{{!nicknameManualMode}}"
            class="field-action-btn"
            bindtap="onTapNicknameField"
          ></button>
        </view>
        <view class="field-helper" bindtap="onTapNicknameField">
          昵称头像：{{profileAuthorized ? '已授权' : '未授权'}}，点此可微信获取或上传头像
        </view>
      </view>

      <view class="field">
        <view class="label">手机号</view>
        <view class="input-wrap" wx:if="{{phoneManualMode}}">
          <input
            class="input"
            type="number"
            value="{{mobile}}"
            bindinput="onMobileInput"
            maxlength="11"
            placeholder="请输入手机号（必填）"
          />
        </view>
        <view class="input-wrap phone-auth-wrap" wx:else>
          <view class="input pseudo-input">{{mobile || '点击输入框获取微信手机号（必填）'}}</view>
          <button
            class="field-action-btn"
            open-type="getPhoneNumber"
            bindgetphonenumber="onGetPhoneNumber"
          ></button>
        </view>
        <view class="field-helper" bindtap="switchPhoneToWechat">
          手机号：{{phoneAuthorized ? '已授权' : '未授权'}}，{{phoneManualMode ? '当前为手动输入，点此改为微信获取' : '点击输入框将直接发起微信授权'}}
        </view>
      </view>
    </view>

    <button class="submit-btn" loading="{{submitting}}" bindtap="submitProfile">完成登录</button>
  </view>
</van-popup>
